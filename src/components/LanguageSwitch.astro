---
import { locales, resolveLocale, type LocaleCode } from '../i18n/locales';
import { withBase } from '../lib/url';
import { getContent } from '../data/content';

interface Props {
  /**
   * Where each locale's copy of the current page lives, without the base
   * prefix. Only translated sub-pages need this — everything else is one of
   * the two home pages, which is what a locale's own `path` already is.
   */
  paths?: Partial<Record<LocaleCode, string>>;
  /** Hide the fixed switch in print layouts, used by article pages. */
  hideOnPrint?: boolean;
}

const { paths, hideOnPrint = false } = Astro.props;
const lang = resolveLocale(Astro.currentLocale);
const suggestedLocale = locales.find((locale) => locale.code !== lang)!;
const suggestedHref = withBase(paths?.[suggestedLocale.code] ?? suggestedLocale.path);
const prompt = getContent(suggestedLocale.code).languagePrompt;
---

{/* Fixed in the top corner on every page, with its own opaque pill rather
    than inheriting section colour — the page scrolls behind it through both
    light and on-ink sections, and a translucent chip stays legible on both.

    Below 480px it collapses to a single round chip carrying one glyph — the
    language you would switch to. A phone has no room for a two-part control
    up there without the hero having to be padded down to clear it, and with
    only two locales the pair is a toggle anyway: the one on offer is the one
    you are not reading. */}
<nav
  aria-label="Language"
  class:list={[
    'fixed top-4 right-4 z-50 flex items-center gap-0.5 rounded-full border border-ink/15 bg-paper/95 p-0.5 shadow-sm backdrop-blur-sm min-[480px]:p-1',
    hideOnPrint && 'no-print',
  ]}
  style="view-transition-name:language-switch"
>
  {
    locales.map((locale) => {
      const active = locale.code === lang;
      return active ? (
        <span class="mono-label hidden rounded-full bg-ink px-3 py-1.5 text-paper min-[480px]:block">
          {locale.label}
        </span>
      ) : (
        <a
          href={suggestedHref}
          aria-label={locale.name}
          class="mono-label flex h-10 w-10 items-center justify-center rounded-full text-ink transition-colors duration-300 hover:bg-ink/8 hover:text-ink min-[480px]:h-auto min-[480px]:w-auto min-[480px]:px-3 min-[480px]:py-1.5 min-[480px]:text-slate"
          data-lang-link
          data-locale={locale.code}
        >
          {/* Tracking is set for a run of Latin capitals; on a lone glyph it
              only pushes it off centre. */}
          <span class="tracking-normal min-[480px]:hidden" aria-hidden="true">
            {locale.short}
          </span>
          <span class="hidden min-[480px]:inline" aria-hidden="true">
            {locale.label}
          </span>
        </a>
      );
    })
  }
</nav>

<dialog
  data-language-prompt
  data-current-locale={lang}
  lang={suggestedLocale.code}
  aria-labelledby="language-prompt-title"
  aria-describedby="language-prompt-description"
  class="language-prompt no-print m-auto max-h-[calc(100dvh-2.5rem)] w-[calc(100%-2.5rem)] max-w-md overflow-y-auto rounded-2xl border border-ink/15 bg-paper p-6 text-ink shadow-2xl sm:p-8"
>
  <p class="eyebrow mb-4 text-jade">{prompt.label}</p>
  <h2 id="language-prompt-title" class="text-2xl leading-tight sm:text-3xl">
    {prompt.title}
  </h2>
  <p id="language-prompt-description" class="mt-4 text-base text-slate">
    {prompt.description}
  </p>
  <div class="mt-7 flex flex-col gap-3 font-display text-sm font-semibold">
    <a
      href={suggestedHref}
      data-lang-link
      data-locale={suggestedLocale.code}
      class="rounded-full bg-jade px-5 py-3 text-center text-paper transition-colors hover:bg-ink"
    >
      {prompt.switchLabel}
    </a>
    <button
      type="button"
      data-language-stay
      autofocus
      class="cursor-pointer rounded-full border border-ink/20 px-5 py-3 transition-colors hover:bg-ink/8"
    >
      {prompt.stayLabel}
    </button>
  </div>
</dialog>

<style>
  .language-prompt::backdrop {
    background: rgb(12 26 27 / 55%);
    backdrop-filter: blur(4px);
  }

  :global(html:has([data-language-prompt][open])) {
    overflow: hidden;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-language-prompt]');
  const choiceKey = 'locale-choice';

  // A choice acknowledges the suggestion; it never redirects later visits.
  // Session storage also covers browsers where persistent storage is blocked.
  const rememberChoice = (locale: string) => {
    for (const storage of ['localStorage', 'sessionStorage'] as const) {
      try {
        window[storage].setItem(choiceKey, locale);
      } catch {
        // Choosing a language must still work when storage is unavailable.
      }
    }
  };

  const hasChoice = () => {
    for (const storage of ['localStorage', 'sessionStorage'] as const) {
      try {
        const choice = window[storage].getItem(choiceKey);
        if (choice === 'en' || choice === 'zh-Hant-TW') return true;
      } catch {
        // Try the other storage mechanism before showing the suggestion.
      }
    }
    return false;
  };

  // Preserve the reading position across a language switch, so the other
  // locale opens exactly where the reader was rather than at the top.
  //
  // Still required alongside the view transition: the transition animates
  // between the two documents, but the second one is a fresh navigation and
  // starts at the top. The two are complementary — this decides where you
  // land, the transition decides how.
  //
  // Recorded as a section plus how far through it, not as a scroll offset.
  // The two documents are not the same height — the Chinese copy is shorter
  // almost everywhere — so the same offset lands in a different place in the
  // other language, and the further down the page the reader is, the further
  // out it drifts. Anchoring to a section resets that error at every heading.
  //
  // Computed at click time rather than page load, since the reader has
  // usually scrolled without ever touching a link.
  const sections = [
    ...document.querySelectorAll<HTMLElement>('main > section[id]'),
  ];

  const remember = () => {
    if (!sections.length) return;

    // The section the top of the window is currently inside: the last one
    // whose own top has already passed it.
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= 1) current = section;
    }

    // top is negative once a section's start is above the window, so -top is
    // how far into it the reader has gone.
    const box = current.getBoundingClientRect();
    const through = -box.top / (box.height || 1);

    try {
      sessionStorage.setItem(
        'locale-scroll',
        JSON.stringify({
          id: current.id,
          through: Math.min(Math.max(through, 0), 1),
        }),
      );
    } catch {
      // Storage unavailable (Safari private browsing throws). The other
      // locale opens at the top, which is where it used to open anyway.
    }
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '[data-lang-link]',
  )) {
    link.addEventListener('click', () => {
      rememberChoice(link.dataset.locale!);
      // Remove the modal before the outgoing view-transition snapshot.
      dialog?.close();
      remember();
    });
  }

  if (dialog) {
    const stay = () => {
      rememberChoice(dialog.dataset.currentLocale!);
      dialog.close();
    };
    dialog.querySelector('[data-language-stay]')?.addEventListener('click', stay);
    dialog.addEventListener('cancel', stay); // Escape is also a choice to stay.

    // Use the first preference, so Chinese as a secondary language does not
    // override a visitor's preferred English (or any other non-Chinese language).
    const language = navigator.languages?.[0] || navigator.language;
    if (language && !hasChoice() && typeof dialog.showModal === 'function') {
      const preferredLocale = /^zh(?:[-_]|$)/i.test(language) ? 'zh-Hant-TW' : 'en';
      if (preferredLocale !== dialog.dataset.currentLocale) dialog.showModal();
    }
  }
</script>
