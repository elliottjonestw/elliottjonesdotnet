---
import { locales, resolveLocale } from '../i18n/locales';
import { withBase } from '../lib/url';

const lang = resolveLocale(Astro.currentLocale);
---

{/* Fixed in the top corner on every page, with its own opaque pill rather
    than inheriting section colour — the page scrolls behind it through both
    light and on-ink sections, and a translucent chip stays legible on both.

    Below 480px it collapses to a single round chip carrying one glyph — the
    language you would switch to. A phone has no room for a two-part control
    up there without the hero having to be padded down to clear it, and with
    only two locales the pair is a toggle anyway: the one on offer is the one
    you are not reading. */}
<nav
  aria-label="Language"
  class="fixed top-4 right-4 z-50 flex items-center gap-0.5 rounded-full border border-ink/15 bg-paper/95 p-0.5 shadow-sm backdrop-blur-sm min-[480px]:p-1"
  style="view-transition-name:language-switch"
>
  {
    locales.map((locale) => {
      const active = locale.code === lang;
      return active ? (
        <span class="mono-label hidden rounded-full bg-ink px-3 py-1.5 text-paper min-[480px]:block">
          {locale.label}
        </span>
      ) : (
        <a
          href={withBase(locale.path)}
          aria-label={locale.name}
          class="mono-label flex h-10 w-10 items-center justify-center rounded-full text-ink transition-colors duration-300 hover:bg-ink/8 hover:text-ink min-[480px]:h-auto min-[480px]:w-auto min-[480px]:px-3 min-[480px]:py-1.5 min-[480px]:text-slate"
          data-lang-link
        >
          {/* Tracking is set for a run of Latin capitals; on a lone glyph it
              only pushes it off centre. */}
          <span class="tracking-normal min-[480px]:hidden" aria-hidden="true">
            {locale.short}
          </span>
          <span class="hidden min-[480px]:inline" aria-hidden="true">
            {locale.label}
          </span>
        </a>
      );
    })
  }
</nav>

<script>
  // Preserve scroll position across a language switch, so a reader deep in
  // the page lands on the same section on the other locale's home page
  // rather than being bounced back to the top. Computed at click time (not
  // page load), since the reader has usually scrolled without ever putting a
  // hash in the URL — window.location.hash alone would miss that.
  //
  // Still required alongside the view transition: the transition animates
  // between the two documents, but the second one is a fresh navigation and
  // starts at the top unless a fragment says otherwise. The two are
  // complementary — this decides where you land, the transition decides how.
  const sections = [
    ...document.querySelectorAll<HTMLElement>('main > section[id]'),
  ];

  const currentSectionId = () => {
    let current = sections[0]?.id;
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= window.innerHeight / 3) {
        current = section.id;
      }
    }
    return current;
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '[data-lang-link]',
  )) {
    link.addEventListener('click', () => {
      const id = currentSectionId();
      if (!id) return;
      const target = new URL(link.href, window.location.origin);
      target.hash = `#${id}`;
      link.href = target.href;
    });
  }
</script>
