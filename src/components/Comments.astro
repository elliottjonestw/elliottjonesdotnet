---
/**
 * Hosted comments, deliberately kept behind Cusdis rather than a site-owned
 * service. The ID is a stable route key, so changing a post title or canonical
 * domain cannot split its conversation into a new thread.
 */
import displayFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url';

interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
  heading: string;
  composerLabel: string;
}

const { pageId, pageUrl, pageTitle, heading, composerLabel } = Astro.props;
---

<section class="post-comments no-print" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="post-comments-heading mono-label">{heading}</h2>

  <div
    id="cusdis_thread"
    data-cusdis-thread
    data-host="https://cusdis.com"
    data-app-id="3e5065fd-6e96-48e5-b342-e46a7856f18e"
    data-page-id={pageId}
    data-page-url={pageUrl}
    data-page-title={pageTitle}
    data-cusdis-composer-label={composerLabel}
    data-cusdis-display-font={displayFont}
    data-cusdis-body-font={bodyFont}
  ></div>
</section>

<script>
  /**
   * Cusdis's stock loader sometimes applies an obsolete height after the form
   * changes. This wrapper runs the same official widget in an iframe we own,
   * while a ResizeObserver inside that iframe reports its real body height.
   */
  const initialiseCusdis = () => {
    const thread = document.querySelector<HTMLElement>('[data-cusdis-thread]');
    if (!thread || thread.dataset.cusdisReady) return;

    thread.dataset.cusdisReady = 'true';
    const frame = document.createElement('iframe');
    const widgetData = {
      host: thread.dataset.host,
      appId: thread.dataset.appId,
      pageId: thread.dataset.pageId,
      pageUrl: thread.dataset.pageUrl,
      pageTitle: thread.dataset.pageTitle,
    };
    const appearance = {
      composerLabel: thread.dataset.cusdisComposerLabel ?? 'Comment',
      displayFont: thread.dataset.cusdisDisplayFont,
      bodyFont: thread.dataset.cusdisBodyFont,
    };

    frame.title = thread.dataset.cusdisComposerLabel ?? 'Comments';
    frame.style.height = '22rem';
    frame.srcdoc = `<!doctype html>
      <html>
        <head>
          <link rel="stylesheet" href="https://cusdis.com/js/style.css">
          <style>
            @font-face { font-family: 'Elliott Display'; src: url('${appearance.displayFont}') format('woff2'); font-style: normal; font-weight: 100 900; font-display: swap; }
            @font-face { font-family: 'Elliott Body'; src: url('${appearance.bodyFont}') format('woff2'); font-style: normal; font-weight: 100 900; font-display: swap; }
            :root { color-scheme: light; }
            body { color: #0c1a1b; font-family: 'Elliott Body', Georgia, serif; font-size: 1.0625rem; line-height: 1.7; }
            label, input, textarea, button, a { font-family: 'Elliott Display', system-ui, sans-serif; }
            label { color: #0c1a1b; font-weight: 500; }
            input, textarea { border-color: color-mix(in srgb, #0c1a1b 16%, transparent) !important; border-radius: 2px; color: #0c1a1b !important; }
            input:focus, textarea:focus { outline: 2px solid #1f6b57 !important; outline-offset: 2px; }
            button.bg-gray-200 { border-radius: 999px; background: #1f6b57 !important; color: #f5f7f4 !important; font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
            .bg-blue-500 { background: #1f6b57 !important; color: #f5f7f4 !important; font-family: 'Elliott Display', system-ui, sans-serif; font-weight: 500; }
            .text-gray-500 { color: #52666a !important; }
          </style>
          <script>window.__DATA__ = ${JSON.stringify(widgetData)};<\/script>
        </head>
        <body>
          <div id="root"></div>
          <script type="module" src="https://cusdis.com/js/iframe.umd.js"><\/script>
          <script>
            const appearance = ${JSON.stringify(appearance)};
            const customise = () => {
              const composer = document.querySelector('label[for="reply_content"]');
              if (composer && composer.textContent !== appearance.composerLabel) {
                composer.textContent = appearance.composerLabel;
              }
              const field = document.querySelector('[name="reply_content"]');
              if (field) field.title = appearance.composerLabel;
              const attribution = document.querySelector('a[href="https://cusdis.com"]');
              if (attribution && attribution.parentElement) attribution.parentElement.remove();
            };
            const measureHeight = () => {
              const root = document.documentElement;
              const app = document.getElementById('root');
              const contentHeight = Math.max(
                document.body.scrollHeight,
                document.body.offsetHeight,
                app?.scrollHeight ?? 0,
                app?.offsetHeight ?? 0,
              );

              // A scrollbar belongs to the document root, not always the
              // body. Count that height only while it is genuinely
              // overflowing; otherwise its viewport height would keep the
              // iframe artificially tall after the form becomes shorter.
              const rootOverflowHeight = root.scrollHeight > root.clientHeight ? root.scrollHeight : 0;
              return Math.ceil(Math.max(contentHeight, rootOverflowHeight));
            };
            const reportHeight = () => {
              customise();
              parent.postMessage({ type: 'elliottjones-cusdis-height', height: measureHeight() }, '*');
            };
            new ResizeObserver(reportHeight).observe(document.body);
            new ResizeObserver(reportHeight).observe(document.documentElement);
            new MutationObserver(reportHeight).observe(document.body, { childList: true, subtree: true });
            window.addEventListener('load', reportHeight);
            [0, 100, 500].forEach((delay) => setTimeout(reportHeight, delay));
          <\/script>
        </body>
      </html>`;

    thread.append(frame);
  };

  window.addEventListener('message', (event) => {
    const message = event.data;
    if (!message || message.type !== 'elliottjones-cusdis-height') return;

    const frame = document.querySelector<HTMLIFrameElement>('[data-cusdis-thread] iframe');
    const height = Number(message.height);
    if (frame && event.source === frame.contentWindow && Number.isFinite(height) && height > 0) {
      frame.style.height = `${height}px`;
    }
  });

  initialiseCusdis();
  document.addEventListener('astro:page-load', initialiseCusdis);
</script>

<style>
  .post-comments {
    margin-block-start: clamp(3.5rem, 6vw, 5rem);
    padding-block-start: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .post-comments-heading {
    color: var(--color-slate);
  }

  #cusdis_thread {
    margin-block-start: 1.25rem;
  }

  #cusdis_thread :global(iframe) {
    display: block;
    width: 100%;
    border: 0;
  }
</style>
