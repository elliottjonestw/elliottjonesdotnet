---
/**
 * Hosted comments, deliberately kept behind Cusdis rather than a site-owned
 * service. The ID is a stable route key, so changing a post title or canonical
 * domain cannot split its conversation into a new thread.
 */
import displayFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url';

interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
  heading: string;
  composerLabel: string;
}

const { pageId, pageUrl, pageTitle, heading, composerLabel } = Astro.props;
---

<section class="post-comments no-print" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="post-comments-heading mono-label">{heading}</h2>

  <div
    id="cusdis_thread"
    data-cusdis-thread
    data-host="https://cusdis.com"
    data-app-id="3e5065fd-6e96-48e5-b342-e46a7856f18e"
    data-page-id={pageId}
    data-page-url={pageUrl}
    data-page-title={pageTitle}
    data-cusdis-composer-label={composerLabel}
    data-cusdis-display-font={displayFont}
    data-cusdis-body-font={bodyFont}
  ></div>
</section>

<script is:inline async defer src="https://cusdis.com/js/cusdis.es.js"></script>

<script>
  const applyCusdisTheme = (frame: HTMLIFrameElement) => {
    try {
      const document = frame.contentWindow?.document;
      const thread = frame.parentElement;
      if (!document || !thread) return;

      const composerLabel = thread.dataset.cusdisComposerLabel ?? 'Comment';
      const composer = document.querySelector<HTMLLabelElement>('label[for="reply_content"]');
      if (composer && composer.textContent !== composerLabel) {
        composer.textContent = composerLabel;
      }
      const composerField = document.querySelector<HTMLTextAreaElement>('[name="reply_content"]');
      if (composerField) composerField.title = composerLabel;

      if (document.getElementById('elliottjones-cusdis-theme')) return;
      const style = document.createElement('style');
      style.id = 'elliottjones-cusdis-theme';
      style.textContent = `
        @font-face {
          font-family: 'Elliott Display';
          src: url('${thread.dataset.cusdisDisplayFont}') format('woff2');
          font-style: normal;
          font-weight: 100 900;
          font-display: swap;
        }
        @font-face {
          font-family: 'Elliott Body';
          src: url('${thread.dataset.cusdisBodyFont}') format('woff2');
          font-style: normal;
          font-weight: 100 900;
          font-display: swap;
        }
        body {
          color: #0c1a1b;
          font-family: 'Elliott Body', Georgia, serif;
          font-size: 1.0625rem;
          line-height: 1.7;
        }
        label, input, textarea, button, a {
          font-family: 'Elliott Display', system-ui, sans-serif;
        }
        label {
          color: #0c1a1b;
          font-weight: 500;
        }
        input, textarea {
          border-color: color-mix(in srgb, #0c1a1b 16%, transparent) !important;
          border-radius: 2px;
          color: #0c1a1b !important;
        }
        input:focus, textarea:focus {
          outline: 2px solid #1f6b57 !important;
          outline-offset: 2px;
        }
        button.bg-gray-200 {
          border-radius: 999px;
          background: #1f6b57 !important;
          color: #f5f7f4 !important;
          font-size: 0.6875rem;
          font-weight: 500;
          letter-spacing: 0.1em;
          text-transform: uppercase;
        }
        .bg-blue-500 {
          background: #1f6b57 !important;
          color: #f5f7f4 !important;
          font-family: 'Elliott Display', system-ui, sans-serif;
          font-weight: 500;
        }
        .text-gray-500 {
          color: #52666a !important;
        }
      `;
      document.head.append(style);
    } catch {
      // The widget still works in browsers that isolate the iframe document.
    }
  };

  /**
   * Cusdis Cloud occasionally misses its initial iframe-resize message, leaving
   * its otherwise full discussion UI in the browser's 150px iframe default.
   * Keep a generous no-scroll fallback, then use the embedded document's true
   * height whenever the browser permits us to read it. Cusdis's own resize
   * message is unreliable after a form state change, so observe its document
   * directly instead of accepting a potentially stale reported height.
   */
  const resizeCusdisFrame = (frame: HTMLIFrameElement) => {
    try {
      const document = frame.contentWindow?.document;
      if (!document) return;

      // `documentElement.scrollHeight` can inherit the iframe's own minimum
      // height, creating a feedback loop and a large empty area. The body is
      // the element that contains Cusdis's actual form and comments.
      const height = Math.ceil(document.body.scrollHeight);

      if (height > 0) {
        frame.style.height = `${height}px`;
        frame.style.minHeight = '0';
      }
    } catch {
      // Cusdis supplies a cross-origin document in some browsers. In that
      // case the CSS fallback below remains in effect until its resize event.
    }
  };

  const observeCusdisFrame = (frame: HTMLIFrameElement) => {
    if (frame.dataset.resizeObserved) return;

    try {
      const document = frame.contentWindow?.document;
      if (!document?.body) return;

      frame.dataset.resizeObserved = 'true';
      const measure = () => {
        // Let Cusdis finish its own mutation and message handling first; this
        // is the final authoritative measurement for the containing iframe.
        window.requestAnimationFrame(() => resizeCusdisFrame(frame));
      };

      new ResizeObserver(measure).observe(document.body);
      new MutationObserver(measure).observe(document.body, {
        childList: true,
        subtree: true,
      });
      measure();
    } catch {
      // The bounded load measurements provide the fallback for browsers that
      // do not expose the iframe document to its embedding page.
    }
  };

  const initialiseCusdisResize = () => {
    const thread = document.querySelector<HTMLElement>('[data-cusdis-thread]');
    const frame = thread?.querySelector<HTMLIFrameElement>('iframe');
    if (!thread || !frame || frame.dataset.resizeReady) return;

    frame.dataset.resizeReady = 'true';
    const measure = () => {
      applyCusdisTheme(frame);
      resizeCusdisFrame(frame);
      observeCusdisFrame(frame);
    };
    frame.addEventListener('load', () => {
      [0, 200, 1_000, 3_000].forEach((delay) => window.setTimeout(measure, delay));
    });
    measure();
  };

  initialiseCusdisResize();
  const thread = document.querySelector<HTMLElement>('[data-cusdis-thread]');
  if (thread) {
    new MutationObserver(initialiseCusdisResize).observe(thread, { childList: true });
  }
  document.addEventListener('astro:page-load', initialiseCusdisResize);
</script>

<style>
  .post-comments {
    margin-block-start: clamp(3.5rem, 6vw, 5rem);
    padding-block-start: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .post-comments-heading {
    color: var(--color-slate);
  }

  #cusdis_thread {
    margin-block-start: 1.25rem;
  }

  #cusdis_thread :global(iframe) {
    display: block;
    width: 100%;
    min-height: 34rem;
  }
</style>
