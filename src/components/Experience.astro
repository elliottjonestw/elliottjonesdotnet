---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { getContent } from '../data/content';
import { resolveLocale } from '../i18n/locales';

const { experience } = getContent(resolveLocale(Astro.currentLocale));
---

<section id="experience" class="section-pad">
  <div class="shell">
    <SectionHeading
      label={experience.section.label}
      title={experience.section.title}
      intro={experience.section.intro}
    />

    {/* Reverse-chronological, so the rail carries real information: the dates
        are the structure, not decoration. */}
    <ol class="mt-14 lg:mt-20">
      {
        experience.roles.map((role, i) => (
          <li
            class="group relative border-t border-ink/12 last:border-b"
            data-reveal
            style={`--reveal-delay:${Math.min(i, 4) * 70}ms`}
          >
            {/* Jade wipe on hover — the only decoration on the row. */}
            <span
              class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-jade transition-transform duration-500 ease-out group-hover:scale-x-100"
              aria-hidden="true"
            />

            {/* 12rem rather than 10rem for the rail: it now carries the employer
                as well as the dates, and most company names fit on one line at
                this width. */}
            <div class="grid gap-x-8 gap-y-4 py-8 sm:py-10 lg:grid-cols-[12rem_1fr] lg:gap-x-12">
              <div class="flex items-start gap-4 lg:flex-col lg:gap-3">
                <Image
                  src={role.logo}
                  alt={role.logoAlt}
                  widths={[48, 96]}
                  sizes="3rem"
                  class="h-12 w-12 shrink-0 rounded-md bg-surface object-contain p-1.5 ring-1 ring-ink/10"
                  loading="lazy"
                />
                <div>
                  <p class="mono-label text-jade">{role.company}</p>
                  <p class="mono-label mt-1.5 text-slate">{role.period}</p>
                </div>
              </div>

              <div>
                <h3
                  class="font-display text-[clamp(1.375rem,2.6vw,1.875rem)] font-semibold tracking-tight"
                >
                  {role.title}
                </h3>
                {/* No measure cap: the date rail beside it already holds the
                    summary to a comfortable line length. */}
                <p class="mt-4 text-slate">{role.summary}</p>

                {role.media && (
                  <ul class="mt-7 grid gap-4 sm:grid-cols-3">
                    {role.media.map((clip) => (
                      <li>
                        <figure>
                          <div class="aspect-video overflow-hidden rounded-lg bg-ink/5 ring-1 ring-ink/10">
                            <iframe
                              class="h-full w-full"
                              src={`https://www.youtube-nocookie.com/embed/${clip.youtubeId}`}
                              title={clip.caption}
                              loading="lazy"
                              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                              referrerpolicy="strict-origin-when-cross-origin"
                              allowfullscreen
                            />
                          </div>
                          <figcaption class="mono-label mt-2.5 text-slate">
                            {clip.caption}
                          </figcaption>
                        </figure>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
