---
import SectionHeading from './SectionHeading.astro';
import { getContent } from '../data/content';
import { resolveLocale } from '../i18n/locales';

const { capabilities } = getContent(resolveLocale(Astro.currentLocale));
---

<section id="capabilities" class="bg-surface section-pad">
  <div class="shell">
    <SectionHeading label={capabilities.section.label} title={capabilities.section.title} />

    <ul class="mt-14 grid gap-px overflow-hidden rounded-xl bg-ink/10 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3">
      {
        capabilities.items.map((item, i) => (
          <li
            class="bg-paper p-7 transition-colors duration-300 hover:bg-surface sm:p-8"
            data-reveal
            style={`--reveal-delay:${Math.min(i, 5) * 60}ms`}
          >
            <h3
              class="font-display text-lg font-semibold"
            >
              {item.heading}
            </h3>
            <p class="mt-3 text-[0.9375rem] text-slate">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
