---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { certifications, education } from '../data/site';
---

<section id="credentials" class="bg-surface section-pad">
  <div class="shell">
    <SectionHeading
      label="Credentials"
      title="Certifications and education."
    />

    <div class="mt-14 grid gap-x-12 gap-y-14 lg:mt-20 lg:grid-cols-2">
      <div data-reveal>
        <h3 class="mono-label border-b border-ink/12 pb-4 text-slate">
          Certifications
        </h3>
        <ul class="mt-2">
          {
            certifications.map((cert) => (
              <li class="flex items-center gap-4 border-b border-ink/8 py-5">
                <Image
                  src={cert.logo}
                  alt=""
                  widths={[44, 88]}
                  sizes="2.75rem"
                  class="h-11 w-11 shrink-0 rounded bg-surface object-contain p-1 ring-1 ring-ink/10"
                  loading="lazy"
                />
                <div class="min-w-0 flex-1">
                  <p
                    class="font-display font-semibold"
                  >
                    {cert.title}
                  </p>
                  <p class="text-sm text-slate">{cert.issuer}</p>
                </div>
                <span class="mono-label shrink-0 rounded-full border border-ink/15 px-2.5 py-1 text-slate">
                  {cert.note}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--reveal-delay:90ms">
        <h3 class="mono-label border-b border-ink/12 pb-4 text-slate">
          Education
        </h3>
        <ul class="mt-2">
          {
            education.map((entry) => (
              <li class="border-b border-ink/8 py-5">
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center gap-4">
                    <Image
                      src={entry.logo}
                      alt=""
                      widths={[44, 88]}
                      sizes="2.75rem"
                      class="h-11 w-11 shrink-0 rounded bg-surface object-contain p-1 ring-1 ring-ink/10"
                      loading="lazy"
                    />
                    <div class="min-w-0 flex-1">
                      <p
                        class="font-display font-semibold"
                      >
                        {entry.subject}
                      </p>
                      <p class="text-sm text-slate">{entry.school}</p>
                    </div>
                    <span class="mono-label shrink-0 text-jade">
                      <span class="group-open:hidden">
                        {entry.modules.length}
                        {entry.modules.length === 1 ? 'module' : 'modules'}
                      </span>
                      <span class="hidden group-open:inline">Hide</span>
                    </span>
                  </summary>

                  <ul class="mt-5 space-y-2 border-l border-ink/12 pl-5 sm:ml-15">
                    {entry.modules.map((module) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                        <span class="text-[0.9375rem] text-slate">
                          {module.name}
                        </span>
                        <span
                          class:list={[
                            'mono-label',
                            module.grade === 'Distinction'
                              ? 'text-brass'
                              : 'text-slate',
                          ]}
                        >
                          {module.grade}
                        </span>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
