---
import { getContent } from '../data/content';
import { resolveLocale } from '../i18n/locales';

const { imageViewer } = getContent(resolveLocale(Astro.currentLocale));
---

<dialog
  data-image-lightbox
  data-expand-label={imageViewer.expand}
  aria-labelledby="image-lightbox-title"
  aria-describedby="image-lightbox-caption"
  class="image-lightbox no-print on-ink"
>
  <h2 id="image-lightbox-title" class="sr-only">{imageViewer.title}</h2>
  <div class="flex justify-end gap-3 pb-3 font-display text-sm font-medium">
    <button
      type="button"
      data-lightbox-zoom
      data-zoom-label={imageViewer.actualSize}
      data-fit-label={imageViewer.fit}
      aria-pressed="false"
      class="cursor-pointer rounded-full border border-paper/25 px-4 py-2 hover:bg-paper/10"
    >
      {imageViewer.actualSize}
    </button>
    <button
      type="button"
      data-lightbox-close
      autofocus
      class="flex cursor-pointer items-center gap-2 rounded-full border border-paper/25 px-4 py-2 hover:bg-paper/10"
    >
      {imageViewer.close}
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <div class="lightbox-stage" data-lightbox-stage>
    <div class="lightbox-canvas" data-lightbox-canvas></div>
  </div>
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-3 text-sm">
    <p id="image-lightbox-caption" class="max-h-[4.5em] min-w-0 overflow-y-auto text-paper/80"></p>
    <a data-lightbox-original class="shrink-0 font-display text-jade-bright underline underline-offset-4">
      {imageViewer.original}
    </a>
  </div>
</dialog>

<style>
  .image-lightbox {
    width: calc(100% - 2rem);
    max-width: 90rem;
    height: calc(100dvh - 2rem);
    max-height: none;
    margin: auto;
    padding: 1rem;
    border: 1px solid var(--color-ink-line);
    border-radius: 1rem;
    background: var(--color-ink);
    color: var(--color-paper);
    overflow: hidden;
  }

  .image-lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .image-lightbox::backdrop {
    background: rgb(12 26 27 / 80%);
    backdrop-filter: blur(4px);
  }

  .lightbox-stage {
    overflow: auto;
    overscroll-behavior: contain;
    border-radius: 0.25rem;
    background: var(--color-ink-raised);
  }

  .lightbox-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .lightbox-canvas :global(img) {
    flex: none;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
  }

  [data-zoomed] .lightbox-canvas {
    width: max-content;
    height: max-content;
    min-width: 100%;
    min-height: 100%;
  }

  [data-zoomed] .lightbox-canvas :global(img) {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }

  :global(html:has([data-image-lightbox][open])) {
    overflow: hidden;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-image-lightbox]')!;
  const stage = dialog.querySelector<HTMLElement>('[data-lightbox-stage]')!;
  const canvas = dialog.querySelector<HTMLElement>('[data-lightbox-canvas]')!;
  const caption = dialog.querySelector<HTMLElement>('#image-lightbox-caption')!;
  const original = dialog.querySelector<HTMLAnchorElement>('[data-lightbox-original]')!;
  const zoom = dialog.querySelector<HTMLButtonElement>('[data-lightbox-zoom]')!;
  let trigger: HTMLAnchorElement | null = null;

  // Markdown images have their final asset URLs only after Astro renders
  // them. Enhance the rendered article without changing Markdown authoring,
  // nesting anchors, or taking over existing image links.
  if (typeof dialog.showModal === 'function') {
    for (const image of document.querySelectorAll<HTMLImageElement>('[data-expand-images] img')) {
      if (image.closest('a, button')) continue;
      const link = document.createElement('a');
      link.href = image.src;
      link.dataset.expandImage = '';
      link.dataset.imageAlt = image.alt;
      link.dataset.imageCaption = image.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || image.alt;
      link.dataset.imageWidth = image.getAttribute('width') ?? '';
      link.dataset.imageHeight = image.getAttribute('height') ?? '';
      link.dataset.imageExpandLabel = dialog.dataset.expandLabel;
      link.setAttribute('aria-label', `${dialog.dataset.expandLabel}: ${image.alt}`);
      // Keep responsive <picture> sources together if a post uses one.
      const thumbnail = image.closest('picture') ?? image;
      thumbnail.before(link);
      link.append(thumbnail);
    }
  }

  const setZoom = (zoomed: boolean) => {
    dialog.toggleAttribute('data-zoomed', zoomed);
    zoom.setAttribute('aria-pressed', String(zoomed));
    zoom.textContent = zoomed ? zoom.dataset.fitLabel! : zoom.dataset.zoomLabel!;
    // Fit mode constrains the image with CSS; actual size uses its original
    // width and height attributes, allowing the stage to scroll in both axes.
    const image = canvas.querySelector('img');
    if (image) {
      const width = image.naturalWidth || Number(image.getAttribute('width'));
      image.style.width = zoomed && width > 0 ? `${width}px` : '';
    }
    stage.scrollTo({ top: 0, left: 0, behavior: 'instant' });
  };

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element
      ? event.target.closest<HTMLAnchorElement>('a[data-expand-image]')
      : null;
    if (!link || typeof dialog.showModal !== 'function') return;

    event.preventDefault();
    trigger = link;
    const image = new Image();
    image.alt = link.dataset.imageAlt ?? '';
    const width = Number(link.dataset.imageWidth);
    const height = Number(link.dataset.imageHeight);
    if (width > 0) image.width = width;
    if (height > 0) image.height = height;
    image.decoding = 'async';
    image.addEventListener('load', () => {
      image.width = image.naturalWidth;
      image.height = image.naturalHeight;
      if (dialog.hasAttribute('data-zoomed')) image.style.width = `${image.naturalWidth}px`;
    }, { once: true });
    image.src = link.href;
    canvas.replaceChildren(image);
    caption.textContent = link.dataset.imageCaption ?? image.alt;
    original.href = link.href;
    setZoom(false);
    dialog.showModal();
  });

  zoom.addEventListener('click', () => setZoom(!dialog.hasAttribute('data-zoomed')));
  canvas.addEventListener('click', (event) => {
    if (event.target instanceof HTMLImageElement) setZoom(!dialog.hasAttribute('data-zoomed'));
  });
  dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
  // Require both ends of the gesture on the backdrop so dragging an image
  // toward the edge does not accidentally dismiss the viewer.
  let backdropPointerDown = false;
  dialog.addEventListener('pointerdown', (event) => {
    backdropPointerDown = event.target === dialog && outsideDialog(event);
  });
  dialog.addEventListener('click', (event) => {
    if (backdropPointerDown && event.target === dialog && outsideDialog(event)) dialog.close();
    backdropPointerDown = false;
  });
  function outsideDialog(event: MouseEvent) {
    const box = dialog.getBoundingClientRect();
    return event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom;
  }
  dialog.addEventListener('close', () => {
    canvas.replaceChildren();
    trigger?.focus({ preventScroll: true });
    trigger = null;
  });
</script>
