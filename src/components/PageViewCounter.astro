---
/**
 * A static, expandable GA4 summary. The report is prepared during the deploy,
 * so the browser receives no credentials and opening the details is instant.
 */
interface PageViewDetails {
  allTime: number;
  last24Hours: number;
  last30Days: number;
  countries: { name: string; count: number }[];
}

interface Props {
  count: number;
  details?: PageViewDetails;
  generatedAt: string | null;
  locale: 'en' | 'zh-Hant-TW';
  labels: {
    viewCountHeading: string;
    viewCount: string;
    viewCountDetailsOpen: string;
    viewCountDetailsClose: string;
    viewCountLast24Hours: string;
    viewCountLast30Days: string;
    viewCountCountries: string;
    viewCountUpdated: string;
  };
}

const { count, details, generatedAt, locale, labels } = Astro.props;
const minimumViews = 10;
const number = new Intl.NumberFormat(locale === 'zh-Hant-TW' ? 'zh-TW' : 'en-US');
const formattedCount = number.format(count);
const text = labels.viewCount.replace('{count}', formattedCount);
const updated = generatedAt
  ? new Intl.DateTimeFormat(locale === 'zh-Hant-TW' ? 'zh-TW' : 'en-GB', {
      dateStyle: 'medium',
      timeStyle: 'short',
    }).format(new Date(generatedAt))
  : undefined;
const countries = details?.countries ?? [];
const largestCountryCount = Math.max(...countries.map((country) => country.count), 1);
---

{
  count >= minimumViews && (
    <details
      class="post-views"
      aria-label={text}
      data-reveal
      style="--reveal-delay:90ms"
    >
      <summary class="post-views-summary">
        <div class="post-views-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
            <circle cx="12" cy="12" r="2.5" />
          </svg>
        </div>

        <div class="post-views-total">
          <p class="post-views-heading mono-label">{labels.viewCountHeading}</p>
          <p class="post-views-count" aria-hidden="true">{formattedCount}</p>
          <p class="sr-only">{text}</p>
        </div>

        <span class="post-views-toggle mono-label">
          <span class="post-views-toggle-open">{labels.viewCountDetailsOpen}</span>
          <span class="post-views-toggle-close">{labels.viewCountDetailsClose}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="m3 6 5 5 5-5" />
          </svg>
        </span>
      </summary>

      <div class="post-views-details">
        <dl class="post-views-stats">
          <div class="post-views-stat">
            <dt>{labels.viewCountLast24Hours}</dt>
            <dd>{number.format(details?.last24Hours ?? 0)}</dd>
          </div>
          <div class="post-views-stat">
            <dt>{labels.viewCountLast30Days}</dt>
            <dd>{number.format(details?.last30Days ?? 0)}</dd>
          </div>
        </dl>

        {
          countries.length > 0 && (
            <section class="post-views-countries" aria-labelledby="view-countries-heading">
              <h2 id="view-countries-heading" class="post-views-countries-heading mono-label">
                {labels.viewCountCountries}
              </h2>
              <ol>
                {countries.map((country) => (
                  <li>
                    <span class="post-views-country-name">{country.name}</span>
                    <span class="post-views-country-bar" aria-hidden="true">
                      <span
                        style={`--country-share:${(country.count / largestCountryCount) * 100}%`}
                      />
                    </span>
                    <span class="post-views-country-count">{number.format(country.count)}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          updated && (
            <p class="post-views-updated mono-label">
              {labels.viewCountUpdated.replace('{date}', updated)}
            </p>
          )
        }
      </div>
    </details>
  )
}

<style>
  .post-views {
    margin-block-start: clamp(3.5rem, 6vw, 5rem);
    border: 1px solid color-mix(in oklab, var(--color-jade) 58%, var(--rule));
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--color-surface) 88%, var(--color-jade));
    box-shadow: 0.3rem 0.3rem 0 color-mix(in oklab, var(--color-jade) 15%, transparent);
    overflow: hidden;
  }

  .post-views-summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.5rem);
    padding: clamp(1.125rem, 3.5vw, 1.75rem);
    cursor: pointer;
    list-style: none;
  }

  .post-views-summary::-webkit-details-marker {
    display: none;
  }

  .post-views-summary:focus-visible {
    outline: 2px solid var(--color-jade);
    outline-offset: -4px;
  }

  .post-views-icon {
    display: grid;
    width: clamp(2.75rem, 7vw, 3.5rem);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--color-jade) 48%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--color-jade) 10%, transparent);
    color: var(--color-jade);
  }

  .post-views-icon svg {
    width: 52%;
    height: 52%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
  }

  .post-views-heading,
  .post-views-countries-heading,
  .post-views-updated {
    color: var(--color-slate);
  }

  .post-views-count {
    margin: 0.15rem 0 -0.05rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .post-views-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-jade);
    white-space: nowrap;
  }

  .post-views-toggle svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
    transition: transform 0.25s var(--ease-out-quint);
  }

  .post-views-toggle-close {
    display: none;
  }

  .post-views[open] .post-views-toggle-open {
    display: none;
  }

  .post-views[open] .post-views-toggle-close {
    display: inline;
  }

  .post-views[open] .post-views-toggle svg {
    transform: rotate(180deg);
  }

  .post-views-details {
    padding: 0 clamp(1.125rem, 3.5vw, 1.75rem) clamp(1.125rem, 3.5vw, 1.75rem);
  }

  .post-views-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid color-mix(in oklab, var(--color-jade) 28%, transparent);
  }

  .post-views-stat {
    padding: 0.8rem 0.9rem;
    border: 1px solid color-mix(in oklab, var(--color-jade) 24%, transparent);
    border-radius: 0.45rem;
    background: color-mix(in oklab, var(--color-jade) 5%, transparent);
  }

  .post-views-stat dt {
    color: var(--color-slate);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .post-views-stat dd {
    margin: 0.4rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .post-views-countries {
    margin-block-start: 1.35rem;
  }

  .post-views-countries-heading {
    margin: 0;
  }

  .post-views-countries ol {
    display: grid;
    gap: 0.55rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .post-views-countries li {
    display: grid;
    grid-template-columns: minmax(5.5rem, 0.8fr) minmax(3rem, 2fr) auto;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-slate);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .post-views-country-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-views-country-bar {
    display: block;
    height: 0.38rem;
    border-radius: 99px;
    background: color-mix(in oklab, var(--color-jade) 13%, transparent);
    overflow: hidden;
  }

  .post-views-country-bar span {
    display: block;
    width: var(--country-share);
    height: 100%;
    border-radius: inherit;
    background: var(--color-jade);
  }

  .post-views-country-count {
    color: var(--color-ink);
  }

  .post-views-updated {
    margin: 1.25rem 0 0;
    font-size: 0.6rem;
  }

  :global(:lang(zh-Hant)) .post-views-count {
    letter-spacing: -0.02em;
  }

  :global(:lang(zh-Hant)) .post-views-stat dt {
    letter-spacing: 0.02em;
    text-transform: none;
  }

  @media (max-width: 520px) {
    .post-views-summary {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .post-views-toggle {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
