---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { getContent } from '../data/content';
import { resolveLocale } from '../i18n/locales';

const { projects } = getContent(resolveLocale(Astro.currentLocale));
---

<section id="projects" class="bg-surface section-pad">
  <div class="shell">
    <SectionHeading label={projects.section.label} title={projects.section.title} />

    {/* One card per project, laid out wide rather than in a column grid, so a
        single entry reads as deliberate instead of half a row. */}
    {/* Tighter than the mt-14/mt-20 the other sections use: this heading has no
        standfirst under it, so the usual gap reads as a hole. */}
    <ul class="mt-9 space-y-5 lg:mt-12">
      {
        projects.items.map((project, i) => (
          <li
            class="rounded-xl border border-ink/12 p-7 transition-colors duration-500 hover:border-jade/50 sm:p-9"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            {/* Three blocks: the description, the screenshots, then the stack
                and links. Stacked in that order on a phone, so a screenshot
                arrives before the reader has to scroll past the metadata; on
                desktop the first and third sit in column one and the
                screenshots take column two across both rows. */}
            <div class="grid gap-10 lg:grid-cols-[1.9fr_1fr] lg:gap-x-14 lg:gap-y-8">
              <div class="lg:col-start-1 lg:row-start-1">
                <div class="flex items-baseline gap-3">
                  <p class="mono-label text-jade">{project.kind}</p>
                  <p class="mono-label text-slate">{project.year}</p>
                </div>

                <h3 class="font-display mt-5 text-[clamp(1.375rem,2.6vw,2rem)] leading-[1.12] font-semibold tracking-tight">
                  {project.title}
                </h3>
                <p class="mt-4 text-[0.9375rem] text-slate">{project.summary}</p>

                {/* Phones get the summary, the stack and one screenshot. The
                    detail list is where the card's height comes from, and it is
                    the part that reads worst once every line wraps. */}
                <ul class="mt-6 hidden space-y-2.5 md:block">
                  {project.highlights.map((highlight) => (
                    <li class="flex items-start gap-3">
                      <span
                        class="mt-2.5 h-px w-4 shrink-0 bg-ink/25"
                        aria-hidden="true"
                      />
                      <span class="text-[0.9375rem] leading-snug text-slate">
                        {highlight}
                      </span>
                    </li>
                  ))}
                </ul>

              </div>

              {/* The screenshots take their own column on desktop, centred
                  against the two text blocks so the leftover height splits above
                  and below them rather than pooling underneath. The column caps
                  its own width so it never outgrows the copy once everything is
                  in one column. */}
              {/* flex gap rather than space-y: space-y hangs a margin off every
                  non-last child, and the second figure is still a child when it
                  is hidden on phones — leaving dead space under the first. */}
              <div class="mx-auto flex w-full max-w-md flex-col gap-6 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mx-0 lg:self-center">
                {project.shots.map((shot, s) => (
                  <figure class={s === 0 ? '' : 'hidden md:block'}>
                    <Image
                      src={shot.image}
                      alt={shot.alt}
                      widths={[420, 640, 840]}
                      sizes="(min-width:1024px) 21rem, (min-width:640px) 28rem, 92vw"
                      quality={90}
                      class="w-full rounded-lg border border-ink/12"
                      loading="lazy"
                    />
                    <figcaption class="mono-label mt-3 text-slate">
                      {shot.caption}
                    </figcaption>
                  </figure>
                ))}
              </div>

              <div class="lg:col-start-1 lg:row-start-2">
                <p class="mono-label hidden text-slate md:block">{projects.stackLabel}</p>
                <ul class="mt-4 hidden flex-wrap gap-2 md:flex">
                  {project.stack.map((item) => (
                    <li class="mono-label rounded-full border border-ink/15 px-3 py-1.5 text-slate">
                      {item}
                    </li>
                  ))}
                </ul>

                {/* The stack is hidden on phones, so the links carry no top
                    margin there — the grid's row gap already spaces them. */}
                <div class="flex flex-wrap items-center gap-3 md:mt-8">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={
                        link.primary
                          ? 'mono-label rounded-full bg-ink px-6 py-3.5 text-paper transition-colors duration-300 hover:bg-jade'
                          : 'mono-label rounded-full border border-ink/25 px-6 py-3.5 transition-colors duration-300 hover:border-ink hover:bg-ink hover:text-paper'
                      }
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
