---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';
---

<section id="projects" class="bg-surface section-pad">
  <div class="shell">
    <SectionHeading
      label="Personal projects"
      title="Ideas I took from specification to production."
    />

    {/* One card per project, laid out wide rather than in a column grid, so a
        single entry reads as deliberate instead of half a row. */}
    {/* Tighter than the mt-14/mt-20 the other sections use: this heading has no
        standfirst under it, so the usual gap reads as a hole. */}
    <ul class="mt-9 space-y-5 lg:mt-12">
      {
        projects.map((project, i) => (
          <li
            class="rounded-xl border border-ink/12 p-7 transition-colors duration-500 hover:border-jade/50 sm:p-9"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="grid gap-10 lg:grid-cols-[1.9fr_1fr] lg:items-center lg:gap-14">
              <div>
                <div class="flex items-baseline gap-3">
                  <p class="mono-label text-jade">{project.kind}</p>
                  <p class="mono-label text-slate">{project.year}</p>
                </div>

                <h3 class="font-display mt-5 text-[clamp(1.375rem,2.6vw,2rem)] leading-[1.12] font-semibold tracking-tight">
                  {project.title}
                </h3>
                <p class="mt-4 text-[0.9375rem] text-slate">{project.summary}</p>

                <ul class="mt-6 space-y-2.5">
                  {project.highlights.map((highlight) => (
                    <li class="flex items-start gap-3">
                      <span
                        class="mt-2.5 h-px w-4 shrink-0 bg-ink/25"
                        aria-hidden="true"
                      />
                      <span class="text-[0.9375rem] leading-snug text-slate">
                        {highlight}
                      </span>
                    </li>
                  ))}
                </ul>

                <p class="mono-label mt-8 text-slate">Stack</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {project.stack.map((item) => (
                    <li class="mono-label rounded-full border border-ink/15 px-3 py-1.5 text-slate">
                      {item}
                    </li>
                  ))}
                </ul>

                <div class="mt-8 flex flex-wrap items-center gap-3">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={
                        link.primary
                          ? 'mono-label rounded-full bg-ink px-6 py-3.5 text-paper transition-colors duration-300 hover:bg-jade'
                          : 'mono-label rounded-full border border-ink/25 px-6 py-3.5 transition-colors duration-300 hover:border-ink hover:bg-ink hover:text-paper'
                      }
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>

              {/* The screenshots sit stacked in a narrow column, centred against
                  the text so the leftover height splits above and below them
                  rather than pooling underneath. The column caps its own width
                  so it never outgrows the copy once everything is one column. */}
              <div class="mx-auto w-full max-w-md space-y-6 lg:mx-0">
                {project.shots.map((shot) => (
                  <figure>
                    <Image
                      src={shot.image}
                      alt={shot.alt}
                      widths={[420, 640, 840]}
                      sizes="(min-width:1024px) 21rem, (min-width:640px) 28rem, 92vw"
                      quality={90}
                      class="w-full rounded-lg border border-ink/12"
                      loading="lazy"
                    />
                    <figcaption class="mono-label mt-3 text-slate">
                      {shot.caption}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
