---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.png';
import { getContent } from '../data/content';
import { resolveLocale } from '../i18n/locales';

const { hero, person } = getContent(resolveLocale(Astro.currentLocale));
---

{/* The hero fills the first screen, so the dark section below it never bleeds
    into the fold. min-height rather than height: if the content is taller than
    the viewport the section simply grows. */}
<section
  id="top"
  class="relative flex min-h-svh flex-col justify-center overflow-hidden pt-9 pb-16 max-[479px]:pt-16 sm:pt-12 lg:pb-24"
>
  {/* Ambient jade wash behind the opening frame. Purely atmospheric. */}
  <div
    class="pointer-events-none absolute -top-1/3 -right-1/4 -z-10 h-[38rem] w-[38rem] rounded-full opacity-[0.13] blur-3xl"
    style="background:radial-gradient(circle,var(--color-jade) 0%,transparent 68%)"
    aria-hidden="true"
  >
  </div>

  <div class="shell">
    {/* Two separate arrangements rather than one that bends. Below 480px — the
        widest phone in portrait — the introduction is cut back to the portrait,
        the name and the job title; place and employer are dropped because the
        lead paragraph directly beneath names both. That leaves the name enough
        width to sit beside the portrait without being squeezed. */}

    {/* ── Phone portrait ───────────────────────────────────────────────── */}
    <div class="flex items-center gap-4 min-[480px]:hidden">
      <div class="w-16 shrink-0" data-hero="1">
        <Image
          src={headshot}
          alt={`${person.name}, ${person.role} at ${person.company}`}
          widths={[64, 128, 192]}
          sizes="4rem"
          class="aspect-square w-full rounded-xl object-cover ring-1 ring-jade/25"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="min-w-0">
        {/* Sized off the viewport so the name always clears the portrait on one
            line, from 320px up. */}
        <h1
          class="font-display text-[clamp(2rem,9.5vw,2.75rem)] leading-[0.94] font-bold tracking-[-0.032em]"
        >
          <span class="hero-line">
            <span class="block" data-hero="2">{person.name}</span>
          </span>
        </h1>
        {/* balance rather than a hard break: on the narrowest screens the title
            splits evenly instead of leaving one word stranded. */}
        <p
          class="mono-label mt-2 text-[0.625rem] leading-[1.7] tracking-[0.12em] text-balance text-jade"
          data-hero="3"
        >
          {hero.eyebrow}
        </p>
      </div>
    </div>

    {/* ── 480px and up ─────────────────────────────────────────────────── */}
    <div class="hidden items-center gap-6 min-[480px]:flex sm:gap-8">
      <div class="shrink-0" data-hero="1">
        {/* The jade edge sits inside the layout box rather than around it, so
            the portrait's left edge lines up exactly with the text below. */}
        <div class="w-20 sm:w-24 lg:w-28">
          <Image
            src={headshot}
            alt={`${person.name}, ${person.role} at ${person.company}`}
            widths={[80, 112, 160, 224]}
            sizes="(min-width:1024px) 7rem, (min-width:640px) 6rem, 5rem"
            class="aspect-square w-full rounded-2xl object-cover ring-1 ring-jade/25"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="min-w-0">
        <p class="eyebrow text-xs tracking-[0.16em]" data-hero="1">
          {person.location}
        </p>
        <h1 class="font-display mt-3 text-display font-bold">
          <span class="hero-line">
            <span class="block" data-hero="2">{person.name}</span>
          </span>
        </h1>
        {/* Role and company break onto their own lines on narrow screens rather
            than wrapping mid-phrase. */}
        <p
          class="mono-label mt-3 text-[0.6875rem] tracking-[0.14em] text-jade"
          data-hero="3"
        >
          <span class="block md:inline">{hero.eyebrow}</span>
          <span class="hidden md:inline"> · </span>
          <span class="block md:inline">{person.company}</span>
        </p>
      </div>
    </div>

    <div class="mt-8 max-w-5xl" data-hero="4">
      <p class="text-lead text-slate">{hero.lead}</p>

      {/* On a phone the two calls to action stack full width — a thumb-sized
          target across the screen rather than two ragged pills. From 480px up
          they sit on one row at their content width. */}
      <div
        class="mt-8 flex flex-col gap-3 min-[480px]:flex-row min-[480px]:flex-wrap min-[480px]:items-center"
      >
        <a
          href="#mandarin"
          class="mono-label block rounded-full bg-ink px-6 py-4 text-center text-paper transition-colors duration-300 hover:bg-jade min-[480px]:py-3.5"
        >
          {hero.ctaMandarin}
        </a>
        <a
          href="#experience"
          class="mono-label block rounded-full border border-ink/25 px-6 py-4 text-center transition-colors duration-300 hover:border-ink hover:bg-ink hover:text-paper min-[480px]:py-3.5"
        >
          {hero.ctaExperience}
        </a>
      </div>
    </div>

    {/* Credential strip. Every figure here is evidenced further down the page. */}
    <dl
      class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-lg bg-ink/10 md:grid-cols-4 lg:mt-20"
      data-hero="5"
    >
      {/* The figure reads first and the label sits underneath it. The column is
          reversed rather than reordered in the markup, so the dt still precedes
          its dd for anyone reading the list through assistive technology.
          justify-between pins the figures to the top and the labels to the
          bottom, so both stay aligned across tiles even when a label wraps to
          two lines on narrow screens. */}
      {
        hero.facts.map((fact) => (
          <div class="group relative flex h-full flex-col-reverse justify-between gap-3 bg-paper p-5 transition-colors duration-300 sm:p-6 hover:bg-surface">
            <dt class="mono-label text-slate">{fact.label}</dt>
            <dd
              class="font-display text-2xl font-bold transition-colors duration-300 group-hover:text-jade md:text-3xl"
            >
              {fact.value}
            </dd>
            {'href' in fact && fact.href && (
              <a href={fact.href} class="absolute inset-0">
                <span class="sr-only">
                  {fact.label}: {fact.value}
                </span>
              </a>
            )}
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* The name sits in a mask so it can rise into view on load. The padding keeps
     descenders from being clipped by the mask. */
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  /* Opening sequence: the name lifts in, then the supporting material follows. */
  @media (prefers-reduced-motion: no-preference) {
    [data-hero] {
      animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    [data-hero='1'] {
      animation-delay: 0.05s;
    }
    [data-hero='2'] {
      animation-delay: 0.16s;
    }
    [data-hero='3'] {
      animation-delay: 0.3s;
    }
    [data-hero='4'] {
      animation-delay: 0.42s;
    }
    [data-hero='5'] {
      animation-delay: 0.52s;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.85em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
