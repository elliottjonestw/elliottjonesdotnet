---
interface Props {
  /** Mono uppercase label, e.g. "Experience". */
  label: string;
  /** The section's actual heading. */
  title: string;
  /** Optional standfirst below the heading. */
  intro?: string;
  class?: string;
}

const { label, title, intro, class: className = '' } = Astro.props;
---

{/* The width cap sits on the heading rather than the header, so the standfirst
    can run wider than the title — the same measure as the hero's lead. */}
<header class={className}>
  <p class="eyebrow" data-reveal>{label}</p>
  <h2 class="mt-5 max-w-3xl text-section" data-reveal style="--reveal-delay:60ms">
    {title}
  </h2>
  {
    intro && (
      <p
        class="mt-6 max-w-5xl text-lead text-slate"
        data-reveal
        style="--reveal-delay:120ms"
      >
        {intro}
      </p>
    )
  }
</header>
