---
import SectionHeading from './SectionHeading.astro';
import { getContent } from '../data/content';
import { resolveLocale } from '../i18n/locales';

const { work } = getContent(resolveLocale(Astro.currentLocale));
---

<section id="work" class="section-pad">
  <div class="shell">
    <SectionHeading
      label={work.section.label}
      title={work.section.title}
      intro={work.section.intro}
    />

    {/* min-w-0 on each column: the rows below truncate rather than wrap, and a
        grid item defaults to min-width:auto — without it the column is sized to
        the longest untruncated title and the whole page overflows on a phone,
        carrying the fixed language switch off the right edge with it. */}
    <div class="mt-14 grid gap-x-12 gap-y-14 lg:mt-20 lg:grid-cols-3">
      {
        work.groups.map((group, i) => (
          <div class="min-w-0" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="flex items-baseline gap-3 border-b border-ink/12 pb-4">
              <h3
                class="font-display text-xl font-semibold"
              >
                {group.group}
              </h3>
              <span class="mono-label text-slate">{group.items.length}</span>
            </div>
            <p class="mt-4 text-sm text-slate">{group.note}</p>

            <ul class="mt-5 space-y-px">
              {group.items.map((item) => (
                <li>
                  {/* title carries the full label, since long ones are
                      truncated to keep every row on a single line. */}
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={item.label}
                    class="group flex items-start gap-3 py-2.5 transition-colors duration-300 hover:text-jade"
                  >
                    <span
                      class="mt-2.5 h-px w-4 shrink-0 bg-ink/25 transition-all duration-300 group-hover:w-6 group-hover:bg-jade"
                      aria-hidden="true"
                    />
                    <span class="min-w-0 truncate text-[0.9375rem] leading-snug">
                      {item.label}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
