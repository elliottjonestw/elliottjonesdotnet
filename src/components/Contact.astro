---
import SectionSeam from './SectionSeam.astro';
import { getContent } from '../data/content';
import { resolveLocale } from '../i18n/locales';

const { contact, person } = getContent(resolveLocale(Astro.currentLocale));
const body = contact.body.replace('{location}', person.location);
const year = new Date().getFullYear();
---

<section
  id="contact"
  class="on-ink relative overflow-hidden bg-ink text-paper section-pad"
>
  <div
    class="pointer-events-none absolute -right-40 -bottom-48 h-[36rem] w-[36rem] rounded-full opacity-25 blur-3xl"
    style="background:radial-gradient(circle,var(--color-jade) 0%,transparent 70%)"
    aria-hidden="true"
  >
  </div>

  {/* Top edge only — the bottom of this section is the bottom of the page. */}
  <SectionSeam edge="top" />

  <div class="shell relative">
    <p class="eyebrow" data-reveal>{contact.eyebrow}</p>

    <h2
      class="mt-5 max-w-3xl text-section"
      data-reveal
      style="--reveal-delay:60ms"
    >
      {contact.title}
    </h2>

    <p
      class="mt-6 max-w-5xl text-lead text-paper/70"
      data-reveal
      style="--reveal-delay:120ms"
    >
      {body}
    </p>

    <div
      class="mt-12 flex flex-wrap items-center gap-3"
      data-reveal
      style="--reveal-delay:180ms"
    >
      {/* Copies rather than opening a mail client — mailto: is unreliable in
          browsers without a registered handler. */}
      <button
        type="button"
        class="copy-button mono-label rounded-full bg-paper px-7 py-4 text-ink transition-colors duration-300 hover:bg-jade-bright"
        data-copy-email
        data-email={person.email}
        data-copy-success={contact.copySuccess}
        data-copy-fallback-key={contact.copyFallbackKey}
        data-copy-fallback-select={contact.copyFallbackSelect}
      >
        {/* The confirmation, wiped through the pill rather than only spelled
            out in it. Purely decorative — the words still change, and the live
            region below announces them. */}
        <span class="copy-fill" aria-hidden="true"></span>
        <span class="copy-text" data-copy-label>{contact.copyIdle}</span>
      </button>
      <a
        href={person.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="mono-label rounded-full border border-paper/30 px-7 py-4 transition-colors duration-300 hover:border-paper hover:bg-paper hover:text-ink"
      >
        {contact.linkedinLabel}
      </a>
    </div>

    {/* Also shown as plain selectable text, so the address is available even if
        the clipboard API is blocked. */}
    <p class="mt-6 text-sm break-all text-paper/55" data-reveal>
      <span class="select-all">{person.email}</span>
    </p>

    {/* Politeness level "polite" so the confirmation is announced without
        interrupting whatever the user is doing. */}
    <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>

    <footer class="mt-20 border-t border-paper/12 pt-8">
      <p class="mono-label text-paper/60">© {year} {person.name}</p>
    </footer>
  </div>
</section>

<style>
  .copy-button {
    position: relative;
    /* Keeps the fill inside the pill's rounded ends. */
    overflow: hidden;
  }

  .copy-fill {
    position: absolute;
    inset: 0;
    background: var(--color-jade);
    transform: scaleX(0);
    /* The resting origin is the one the fill leaves by. Setting it here rather
       than only on the way out means the origin has already flipped by the time
       the class is removed, so the wipe goes out the same way it came in —
       left to right — instead of retreating back the way it arrived.
       Switching it is free: at scaleX(0) and scaleX(1) both origins look
       identical, so the change is never visible. */
    transform-origin: right;
    transition: transform 0.45s var(--ease-out-quint);
  }

  .copy-button.is-copied .copy-fill {
    transform: scaleX(1);
    transform-origin: left;
  }

  .copy-text {
    position: relative;
  }

  /* Flips as the fill passes under it rather than ahead of it. */
  .copy-button.is-copied .copy-text {
    color: var(--color-paper);
    transition: color 0.2s linear 0.18s;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const label = button?.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  if (button && label) {
    const idle = label.textContent ?? 'Copy email address';
    let reset: number | undefined;

    // `copied` drives the wipe, so it is only set where the address actually
    // reached the clipboard — the fallbacks are instructions to the reader, not
    // confirmations, and should not be dressed as success.
    const say = (text: string, copied = false) => {
      label.textContent = text;
      if (status) status.textContent = text;
      button.classList.toggle('is-copied', copied);
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = idle;
        if (status) status.textContent = '';
        button.classList.remove('is-copied');
      }, 2600);
    };

    button.addEventListener('click', async () => {
      const email = button.dataset.email ?? '';
      const success = button.dataset.copySuccess ?? 'Copied';
      const fallbackKey = button.dataset.copyFallbackKey ?? 'Press ⌘C to copy';
      const fallbackSelect =
        button.dataset.copyFallbackSelect ?? 'Select the address below';

      try {
        await navigator.clipboard.writeText(email);
        say(success, true);
        return;
      } catch {
        // Clipboard API unavailable or blocked (no permission, insecure
        // context). Fall back to a temporary selection + execCommand.
      }

      try {
        const field = document.createElement('textarea');
        field.value = email;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.append(field);
        field.select();
        const ok = document.execCommand('copy');
        field.remove();
        say(ok ? success : fallbackKey, ok);
      } catch {
        say(fallbackSelect);
      }
    });
  }
</script>
