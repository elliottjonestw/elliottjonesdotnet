---
import '../styles/global.css';
// Resolve the hashed URLs of the two faces that render above the fold, so they
// can be preloaded without hardcoding build hashes.
import displayFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url';
import { getContent } from '../data/content';
import { locales, resolveLocale } from '../i18n/locales';
import { absoluteUrl, canonicalUrl, withBase } from '../lib/url';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import SectionRail from '../components/SectionRail.astro';

interface Props {
  title?: string;
  description?: string;
}

const lang = resolveLocale(Astro.currentLocale);
const isZh = lang === 'zh-Hant-TW';
const content = getContent(lang);
const { knowsAbout, mandarin, person } = content;
const { roles: experience } = content.experience;
const { certifications, education } = content.credentials;

const { title = person.metaTitle, description = person.metaDescription } =
  Astro.props;

const site = Astro.site ?? new URL(person.siteUrl);
const canonical = canonicalUrl(Astro.url.pathname, site);
const ogImage = absoluteUrl('og.jpg', site);
/** Identity for the structured-data graph: whatever origin is actually live. */
const home = canonicalUrl('/', site).href.replace(/\/$/, '');

/** Every locale's home page, for hreflang alternates and the OG locale tag. */
const alternates = locales.map((locale) => ({
  ...locale,
  href: canonicalUrl(withBase(locale.path), site).href,
}));

/**
 * ProfilePage wrapping a Person. Google reads ProfilePage for person-focused
 * pages, and the Person node carries the credentials a recruiter would search
 * for — the TOCFL results in particular.
 */
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${home}/#page`,
      url: home,
      name: title,
      description,
      inLanguage: lang,
      primaryImageOfPage: { '@id': `${home}/#og` },
      mainEntity: { '@id': `${home}/#person` },
    },
    {
      '@type': 'ImageObject',
      '@id': `${home}/#og`,
      url: ogImage.href,
      width: 1200,
      height: 630,
    },
    {
      '@type': 'Person',
      '@id': `${home}/#person`,
      name: person.name,
      jobTitle: person.role,
      description,
      url: home,
      email: `mailto:${person.email}`,
      image: ogImage.href,
      sameAs: [person.linkedin],
      nationality: { '@type': 'Country', name: isZh ? '英國' : 'United Kingdom' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: isZh ? '台北市' : 'Taipei',
        addressCountry: 'TW',
      },
      worksFor: { '@type': 'Organization', name: person.company },
      knowsAbout: [...knowsAbout],
      knowsLanguage: [
        {
          '@type': 'Language',
          name: isZh ? '英文' : 'English',
          alternateName: 'en',
        },
        {
          '@type': 'Language',
          name: isZh ? '中文（國語）' : 'Mandarin Chinese',
          alternateName: 'zh-Hant',
        },
      ],
      alumniOf: education.map((entry) => ({
        '@type': 'EducationalOrganization',
        name: entry.school,
      })),
      hasOccupation: experience.map((role) => ({
        '@type': 'Occupation',
        name: role.title,
        occupationLocation: { '@type': 'Place', name: isZh ? '台灣' : 'Taiwan' },
      })),
      hasCredential: [
        ...mandarin.results.map((result) => ({
          '@type': 'EducationalOccupationalCredential',
          name: `TOCFL ${result.tocfl.split(' · ')[0]} ${result.skill} — CEFR ${result.cefr}`,
          credentialCategory: 'Language proficiency',
          recognizedBy: {
            '@type': 'GovernmentOrganization',
            name: mandarin.governmentBody,
          },
        })),
        ...certifications.map((cert) => ({
          '@type': 'EducationalOccupationalCredential',
          name: cert.title,
          credentialCategory: 'Certification',
          recognizedBy: { '@type': 'Organization', name: cert.issuer },
        })),
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={person.name} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    {/* hreflang alternates — every locale's home page points at every other,
        plus itself, and x-default falls back to English for anyone whose
        browser language doesn't match either tag. */}
    {
      alternates.map((locale) => (
        <link rel="alternate" hreflang={locale.hreflang} href={locale.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={alternates.find((locale) => locale.code === 'en')?.href}
    />

    {/* Open Graph — this is what LinkedIn renders when the link is shared. */}
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta
      property="og:locale"
      content={locales.find((locale) => locale.code === lang)?.ogLocale}
    />
    {
      locales
        .filter((locale) => locale.code !== lang)
        .map((locale) => (
          <meta property="og:locale:alternate" content={locale.ogLocale} />
        ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={person.ogImageAlt} />
    <meta property="profile:first_name" content="Elliott" />
    <meta property="profile:last_name" content="Jones" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* The display and body faces both render above the fold. */}
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <link rel="apple-touch-icon" sizes="180x180" href={withBase("apple-touch-icon.png")} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("favicon-32x32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("favicon-16x16.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    <meta name="theme-color" content="#0c1a1b" />
    <meta name="generator" content={Astro.generator} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    {/* Enable reveal animations only when JS runs and motion is welcome, so the
        page is never left blank for anyone else. */}
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }

      // Mark documents entered through a view transition — that is, from the
      // other locale — so the entrance animations can stand down and let the
      // morph carry the arrival on its own. pagereveal fires before the new
      // document's first frame, which is early enough for the class to apply
      // before anything has started playing. Browsers without the event are
      // also browsers without cross-document view transitions, so there is
      // nothing to suppress there either.
      window.addEventListener('pagereveal', (event) => {
        if (event.viewTransition) {
          document.documentElement.classList.add('vt-nav');
        }
      });
    </script>

    {/* GA4, carried over from the previous site. Production builds only, so
        local development never reaches the property. */}
    {
      import.meta.env.PROD && (
        <Fragment>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${person.gaMeasurementId}`}
          />
          {/* set:html rather than define:vars — the latter wraps the snippet in
              an IIFE, which would stop gtag() being callable from elsewhere. */}
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${person.gaMeasurementId}');`}
          />
        </Fragment>
      )
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
      >{content.nav.skipToContent}</a
    >
    {/* How far through the page you are, drawn across the top of the window.
        Sits above the language switch and the rail, both of which it crosses. */}
    <div class="scroll-progress no-print" aria-hidden="true"></div>
    <LanguageSwitch />
    <SectionRail />
    <slot />

    <style>
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        /* Over the language switch (50) and the section rail (40); the bar
           crosses both and should not disappear behind either. */
        z-index: 60;
        pointer-events: none;
        transform-origin: left;
        /* Empty by default, so a browser without scroll-driven animations shows
           nothing at all rather than a bar that is permanently full. */
        transform: scaleX(0);
        /* Deep jade at the start, bright at the leading edge. A single flat
           jade would be legible over the paper sections and nearly lost over
           the two ink ones — the page runs both under this bar. */
        background: linear-gradient(
          to right,
          var(--color-jade),
          var(--color-jade-bright)
        );
      }

      /* The @supports guard matters: without it a browser that does not know
         animation-timeline would drop that one declaration, run the animation
         on the document timeline, and fill the bar once on load. */
      @supports (animation-timeline: scroll()) {
        @media (prefers-reduced-motion: no-preference) {
          .scroll-progress {
            animation: scroll-progress linear;
            animation-timeline: scroll(root block);
          }
        }
      }

      @keyframes scroll-progress {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
    </style>

    <script>
      // Scroll reveal. One shared observer; each element unobserves itself once
      // it has played, so nothing keeps running after the first pass.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (
        'IntersectionObserver' in window &&
        document.documentElement.classList.contains('js-reveal')
      ) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );

        for (const el of targets) observer.observe(el);
      } else {
        for (const el of targets) el.classList.add('is-revealed');
      }
    </script>
  </body>
</html>
