---
/**
 * One post. Everything a post needs on top of Base — the article furniture,
 * the BlogPosting graph, the per-post share image — lives here rather than in
 * the two route files, which differ only in which locale they query.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import ReadAloud from '../components/ReadAloud.astro';
import ShareButtons from '../components/ShareButtons.astro';
/* Loaded here rather than from global.css: the home page is every visitor's
   first request and never renders a word of prose. */
import '../styles/blog.css';
import { getContent } from '../data/content';
import { locales } from '../i18n/locales';
import { canonicalUrl, withBase } from '../lib/url';
import {
  indexRoute,
  listPath,
  metaDescription,
  localeOf,
  postRoute,
  slugOf,
  type PostSummary,
  type TocEntry,
} from '../lib/blog';

interface Props {
  entry: PostSummary;
  toc: TocEntry[];
  /** The posts either side of this one, by date, within the same locale. */
  newer?: PostSummary;
  older?: PostSummary;
}

const { entry, toc, newer, older } = Astro.props;
const { post, locale, slug, excerpt, minutes, dateLabel, dateISO, cover } =
  entry;
const { title, tags } = post.data;

/* The excerpt is a whole paragraph: right for the listing, too long for a
   search snippet. The <meta> tags get a trimmed copy. */
const description = metaDescription(excerpt, locale);

/* Open Graph asks for an ISO 8601 datetime, not a bare date. The frontmatter
   date parses as UTC midnight, which is the right instant to publish. */
const publishedTime = post.data.date.toISOString();

const content = getContent(locale);
const { blog, person } = content;

const site = Astro.site ?? new URL(person.siteUrl);
const canonical = canonicalUrl(Astro.url.pathname, site).href;
const home = canonicalUrl('/', site).href.replace(/\/$/, '');

/**
 * The share image, rendered to the 1200×630 every card reader expects rather
 * than to whatever size the cover happens to be. Posts without a cover fall
 * through to the site-wide og.jpg, which Base supplies.
 */
const share = cover
  ? await getImage({
      src: cover.image,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpeg',
      quality: 88,
    })
  : undefined;

/**
 * Where the other locale's copy of this post lives — but only if it has one.
 * A post written in one language only would otherwise offer a switch straight
 * into a 404; that case lands on the other language's index instead, which is
 * the nearest thing to what was asked for.
 */
const translated = new Set(
  (await getCollection('blog')).map((other) => `${localeOf(other)}:${slugOf(other)}`),
);

const altPaths = Object.fromEntries(
  locales.map((meta) => [
    meta.code,
    translated.has(`${meta.code}:${slug}`)
      ? postRoute(meta.code, slug)
      : indexRoute(meta.code),
  ]),
);

/** Where "all posts" goes, in both the rail and the foot of the article. */
const indexHref = listPath(locale);
const authorHref = withBase(
  locales.find((meta) => meta.code === locale)?.path ?? '',
);

/** One Blog node per locale: they are two blogs' worth of URLs, not one. */
const blogId = `${canonicalUrl(listPath(locale), site).href}#blog`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${canonical}#post`,
      headline: title,
      description,
      inLanguage: locale,
      datePublished: dateISO,
      dateModified: dateISO,
      keywords: tags,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      ...(share ? { image: new URL(share.src, site).href } : {}),
      author: { '@id': `${home}/#person` },
      publisher: { '@id': `${home}/#person` },
      isPartOf: { '@id': blogId },
    },
    {
      '@type': 'Blog',
      '@id': blogId,
      name: blog.metaTitle,
      url: canonicalUrl(listPath(locale), site).href,
      inLanguage: locale,
      author: { '@id': `${home}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${home}/#person`,
      name: person.name,
      jobTitle: person.role,
      url: home,
      sameAs: [person.linkedin],
    },
  ],
};
---

<Base
  title={`${title} — ${person.name}`}
  description={description}
  toc={toc}
  ogType="article"
  ogImage={share ? new URL(share.src, site).href : undefined}
  ogImageAlt={cover?.alt ?? person.ogImageAlt}
  publishedTime={publishedTime}
  structuredData={structuredData}
  altPaths={altPaths}
>
  {/* section-pad and nothing else above the header, so a post opens at the
      same height as the index it came from. The date line is short and sits
      at the left, so it has nothing to clear — the language switch is in the
      opposite corner. */}
  <main id="main">
    <article class="section-pad">
      <div class="shell">
        <div class="post">
          <p class="no-print">
            <a href={indexHref} class="mono-label link-underline text-slate">
              <span aria-hidden="true">←&nbsp;</span>{blog.allPosts}
            </a>
          </p>

          <header id="top" class="post-head mt-8">
            <h1
              class="post-title"
              data-reveal
            >
              {title}
            </h1>

            <p
              class="mono-label mt-5 text-slate"
              data-reveal
              style="--reveal-delay:60ms"
            >
              <time datetime={dateISO}>{dateLabel}</time>
              <span aria-hidden="true"> · </span>
              By <a href={authorHref} class="link-underline">Elliott Jones</a>
              <span aria-hidden="true"> · </span>
              {minutes}&nbsp;{blog.minRead}
            </p>

            <ReadAloud labels={blog} />
          </header>

          {
            cover && (
              <Image
                src={cover.image}
                alt={cover.alt}
                widths={[640, 960, 1280]}
                sizes="(min-width:1024px) 46rem, 92vw"
                quality={88}
                class="post-cover"
                loading="eager"
                fetchpriority="high"
              />
            )
          }

          <div class="prose mt-14">
            <slot />
          </div>

          <ShareButtons title={title} url={canonical} labels={blog} />

          {/* The way on, and the way back. */}
          <nav class="post-nav no-print" aria-label={blog.allPosts}>
            {
              [
                { entry: newer, label: blog.newerPost },
                { entry: older, label: blog.olderPost },
              ].map(({ entry: neighbour, label }) =>
                neighbour ? (
                  <a href={neighbour.href} class="post-nav-link">
                    <span class="mono-label text-jade">{label}</span>
                    <span class="post-nav-title">{neighbour.post.data.title}</span>
                  </a>
                ) : (
                  <span class="post-nav-link post-nav-link--empty" aria-hidden="true" />
                ),
              )
            }
          </nav>

          <div class="post-foot no-print">
            <a href={indexHref} class="mono-label link-underline text-slate">
              {blog.allPosts}
            </a>
            <a href="#top" class="mono-label link-underline text-slate">
              {blog.backToTop}
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Base>

<script>
  const diagrams = document.querySelectorAll<HTMLElement>(
    'pre[data-language="mermaid"]',
  );

  if (diagrams.length > 0) {
    // Keep Mermaid out of the bundle for ordinary prose posts. The dynamic
    // import only runs on pages that actually contain a Mermaid code block.
    const { default: mermaid } = await import('mermaid');
    const style = getComputedStyle(document.documentElement);
    const colour = (name: string) => style.getPropertyValue(name).trim();

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      fontFamily: getComputedStyle(document.body).fontFamily,
      themeVariables: {
        background: colour('--color-paper'),
        primaryColor: colour('--color-paper'),
        primaryTextColor: colour('--color-ink'),
        primaryBorderColor: colour('--color-jade'),
        secondaryColor: colour('--color-surface'),
        secondaryTextColor: colour('--color-ink'),
        secondaryBorderColor: colour('--color-ink-line'),
        tertiaryColor: colour('--color-mist'),
        tertiaryTextColor: colour('--color-ink'),
        tertiaryBorderColor: colour('--color-ink-line'),
        lineColor: colour('--color-jade'),
        edgeLabelBackground: colour('--color-paper'),
      },
      flowchart: {
        htmlLabels: true,
        useMaxWidth: true,
        wrappingWidth: 220,
      },
    });

    for (const [index, diagram] of diagrams.entries()) {
      const source = diagram.querySelector('code')?.textContent?.trim();
      if (!source) continue;

      try {
        const { svg, bindFunctions } = await mermaid.render(
          `mermaid-${index}`,
          source,
        );
        const rendered = document.createElement('div');
        rendered.className = 'mermaid';
        rendered.innerHTML = svg;
        bindFunctions?.(rendered);
        diagram.replaceWith(rendered);
      } catch (error) {
        // Leave the source block in place if a future post contains invalid
        // Mermaid. A readable diagram definition is a better fallback than a
        // missing section of the article.
        console.error('Could not render Mermaid diagram:', error);
      }
    }
  }
</script>

<style>
  /* The reading column. The prose sets its own identical measure, so the
     header, the cover and the footer line up with the body rather than with
     the page gutter. */
  .post {
    max-width: 68ch;
    margin-inline: auto;
  }

  .post-title {
    margin-block-start: 1.25rem;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .post-cover {
    width: 100%;
    height: auto;
    margin-block-start: clamp(2.5rem, 5vw, 3.75rem);
    border-radius: 10px;
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
  }

  .post-nav {
    display: grid;
    gap: 1rem;
    margin-block-start: clamp(4rem, 8vw, 6rem);
    padding-block-start: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 640px) {
    .post-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
    transition:
      border-color 0.5s var(--ease-out-quint),
      background-color 0.5s var(--ease-out-quint);
  }

  @media (hover: hover) {
    a.post-nav-link:hover {
      border-color: color-mix(in oklab, var(--color-jade) 50%, transparent);
      background-color: var(--color-surface);
    }
  }

  /* The first post has no newer one and the last has no older one. The empty
     side keeps its cell so the remaining card stays in its own column rather
     than sliding across the width of the page. */
  .post-nav-link--empty {
    border: 0;
  }

  @media (max-width: 639px) {
    .post-nav-link--empty {
      display: none;
    }
  }

  .post-nav-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .post-foot {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-start: 2.5rem;
  }
</style>
