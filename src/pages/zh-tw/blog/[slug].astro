---
// One route per Traditional Chinese post. See src/pages/blog/[slug].astro for
// the English counterpart.
import { render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import {
  getPosts,
  neighbours,
  toToc,
  type PostSummary,
} from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts('zh-Hant-TW');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, posts },
  }));
}

interface Props {
  entry: PostSummary;
  posts: PostSummary[];
}

const { entry, posts } = Astro.props;
const { Content, headings } = await render(entry.post);
const { newer, older } = neighbours(posts, entry.slug);
---

<BlogPost entry={entry} toc={toToc(headings)} newer={newer} older={older}>
  <Content />
</BlogPost>
